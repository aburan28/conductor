#!/usr/bin/env python3
"""Follow results as they land, printing the answers themselves.

    delphi-follow                 # only results that arrive from now on
    delphi-follow --all           # replay everything already finished
    delphi-follow --root <root>   # one pipeline/goal run only
    delphi-follow --stage expand  # one stage only
    delphi-follow --raw           # the JSON record instead of the text

Batch semantics: the provider returns the whole message when the batch is
collected, so there is no token-by-token stream to show.  What this gives you
is each answer, printed the moment delphi writes it, with the stage and model
it came from.
"""
import argparse, glob, json, os, sys, time

HOME = os.path.expanduser(os.environ.get("DELPHI_HOME", "~/.delphi"))
DONE = os.path.join(HOME, "done")
BOLD, DIM, OFF = "\033[1m", "\033[2m", "\033[0m"
GRN, RED, YEL, CYN = "\033[32m", "\033[31m", "\033[33m", "\033[36m"


def records():
    out = []
    for path in glob.glob(os.path.join(DONE, "*.json")):
        try:
            d = json.load(open(path))
        except Exception:
            continue
        if d.get("status"):
            d["_mtime"] = os.path.getmtime(path)
            out.append(d)
    out.sort(key=lambda d: d.get("_mtime", 0))
    return out


def matches(rec, args):
    meta = rec.get("meta") or {}
    if args.root and meta.get("root") != args.root:
        return False
    if args.stage and meta.get("stage") != args.stage:
        return False
    return True


def show(rec, args):
    meta = rec.get("meta") or {}
    stamp = (rec.get("finished_at") or "")[11:19] or time.strftime("%H:%M:%S")
    ok = rec.get("status") == "succeeded"
    mark = GRN + "✓" if ok else RED + "✗"
    stage = meta.get("stage") or "-"
    model = (rec.get("model") or "?")[:34]
    head = "%s%s%s %s%-34s%s %s%-9s%s %s" % (
        mark, OFF, stamp, CYN, model, OFF, YEL, stage, OFF, rec.get("id", "?"))
    if not ok:
        err = (rec.get("error") or {}).get("message", "")[:300]
        print(head + "\n  " + RED + (err or "failed") + OFF)
        return
    text = rec.get("text") or ""
    if args.raw:
        print(json.dumps(rec, indent=2)[:4000])
        return
    usage = rec.get("usage") or {}
    print(head + DIM + "  %d→%d tok, %d chars" % (
        usage.get("input_tokens", 0), usage.get("output_tokens", 0), len(text)) + OFF)
    print(DIM + "─" * 72 + OFF)
    print(text.rstrip())
    print(DIM + "─" * 72 + OFF)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--root")
    ap.add_argument("--stage")
    ap.add_argument("--interval", type=float, default=2.0)
    ap.add_argument("--raw", action="store_true")
    ap.add_argument("--follow", action="store_true", help="keep watching after --all")
    a = ap.parse_args()

    seen = set()
    if a.all:
        for rec in records():
            if matches(rec, a):
                show(rec, a)
                seen.add(rec.get("id"))
    else:
        # start from what already exists, but do not print it
        seen = {r.get("id") for r in records()}
    if a.all and not a.follow:
        return 0

    sys.stderr.write(DIM + "following %s (Ctrl-C to stop)\n" % DONE + OFF)
    sys.stderr.flush()
    try:
        while True:
            for rec in records():
                rid = rec.get("id")
                if rid in seen or not matches(rec, a):
                    continue
                seen.add(rid)
                show(rec, a)
                sys.stdout.flush()
            time.sleep(a.interval)
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())

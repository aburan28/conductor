<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for Conductor.app under the hardened runtime (packaging/sign.sh).

     No App Sandbox: the app spawns conductor, conductord and Postgres, writes launchd plists
     in ~/Library/LaunchAgents, reads ~/.aws and ~/.claude-*, and runs the coding tools'
     integrations, none of which a sandboxed app may do.

     The hardened runtime restricts almost nothing else it does. The one exception is Apple
     Events: continuing a checkpoint asks Terminal, through osascript, to open a window. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
